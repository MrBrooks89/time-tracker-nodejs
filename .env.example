# ---------------------------------------------------------------------------
# SMTP (email reminders + exception-report distribution — Phase 6 D5/D6)
# ---------------------------------------------------------------------------
# When SMTP_HOST is unset or blank the app runs in LOG-ONLY mode: reminders
# and exception reports are recorded with status "would_send" and nothing is
# dispatched. Set SMTP_HOST to switch to real email delivery.
SMTP_HOST=
# Port defaults to 587 (STARTTLS submission) when unset or invalid.
# Use 465 for implicit TLS.
SMTP_PORT=587
# Auth is omitted when both are empty (e.g. local relay without auth).
SMTP_USER=
SMTP_PASS=
# From address for outgoing mail; falls back to time-tracker@localhost when
# unset. Should be a mailbox your SMTP server is allowed to send as.
SMTP_FROM=

# ---------------------------------------------------------------------------
# AI classification helper (Phase 6 D1/D4)
# ---------------------------------------------------------------------------
# Vercel AI Gateway API key. When unset the AI advisory helper hides itself
# and the app falls back to the deterministic classification rules only.
AI_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# Scheduled reminder cron (Phase 6 D7)
# ---------------------------------------------------------------------------
# Shared secret for /api/reminders/run (GET or POST). Send it as
# "Authorization: Bearer <secret>" or "x-cron-secret: <secret>". When unset,
# only authenticated admin sessions may trigger the route.
CRON_SECRET=
